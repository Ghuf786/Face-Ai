<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI Analyzer Website</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary-color: #007bff;
      --secondary-color: #0056b3;
      --gradient-start: #a8c0ff;
      --gradient-end: #3f2b96;
      --text-color: #fff;
      --accent-color: #ffcc00;
    }
    
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      color: var(--text-color);
      text-align: center;
      padding: 20px;
      min-height: 100vh;
      line-height: 1.6;
    }
    
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }
    
    h1 {
      margin-top: 30px;
      font-size: 2.5em;
      animation: fadeIn 2s ease-in-out;
    }
    
    #preview {
      margin: 20px auto;
      max-width: 300px;
      max-height: 300px;
      border-radius: 15px;
      border: 2px solid var(--text-color);
      display: none;
      object-fit: cover;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    
    .upload-container {
      position: relative;
      margin: 20px auto;
      width: 80%;
      max-width: 300px;
    }
    
    input[type="file"] {
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }
    
    .upload-label {
      display: block;
      padding: 12px;
      background-color: var(--primary-color);
      color: var(--text-color);
      border-radius: 8px;
      font-size: 1em;
      cursor: pointer;
      transition: all 0.3s;
    }
    
    .upload-label:hover {
      background-color: var(--secondary-color);
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    
    .upload-label i {
      margin-right: 8px;
    }
    
    button {
      margin-top: 20px;
      padding: 12px 25px;
      background-color: var(--primary-color);
      border: none;
      border-radius: 8px;
      font-size: 1em;
      color: var(--text-color);
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    
    button:hover {
      background-color: var(--secondary-color);
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }
    
    button:disabled {
      background-color: #cccccc;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
    
    .result {
      margin: 30px auto;
      padding: 20px;
      background-color: rgba(255,255,255,0.1);
      border-radius: 10px;
      display: none;
      animation: fadeIn 2s;
      max-width: 500px;
      backdrop-filter: blur(5px);
      border: 1px solid rgba(255,255,255,0.2);
    }
    
    .result-item {
      margin: 15px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .progress-container {
      width: 60%;
      background-color: rgba(255,255,255,0.2);
      border-radius: 10px;
      height: 10px;
      margin-left: 10px;
    }
    
    .progress-bar {
      height: 100%;
      border-radius: 10px;
      background: linear-gradient(to right, #4facfe, #00f2fe);
      transition: width 0.5s ease-in-out;
    }
    
    .flags {
      margin-top: 20px;
    }
    
    .flags img {
      width: 80px;
      margin: 10px;
      border-radius: 8px;
      border: 2px solid var(--text-color);
      background: var(--text-color);
      transition: transform 0.3s;
    }
    
    .flags img:hover {
      transform: scale(1.1);
    }
    
    nav {
      margin: 20px 0;
      font-size: 1.1em;
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    
    nav a {
      color: var(--text-color);
      text-decoration: none;
      font-weight: bold;
      padding: 8px 15px;
      border-radius: 5px;
      transition: all 0.3s;
    }
    
    nav a:hover {
      background-color: rgba(255,255,255,0.2);
      transform: translateY(-2px);
    }
    
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    
    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.05); }
      100% { transform: scale(1); }
    }
    
    section {
      margin: 50px auto;
      max-width: 600px;
      text-align: left;
      padding: 25px;
      background-color: rgba(255,255,255,0.1);
      border-radius: 10px;
      backdrop-filter: blur(5px);
      border: 1px solid rgba(255,255,255,0.2);
    }
    
    footer {
      margin-top: 50px;
      padding: 20px;
      font-size: 0.9em;
      border-top: 1px solid rgba(255,255,255,0.2);
    }
    
    .loading {
      display: none;
      margin: 20px auto;
      text-align: center;
    }
    
    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top: 4px solid var(--text-color);
      animation: spin 1s linear infinite;
      margin: 0 auto;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    /* Responsive adjustments */
    @media (max-width: 600px) {
      h1 {
        font-size: 2em;
      }
      
      .container {
        padding: 10px;
      }
      
      nav {
        gap: 10px;
      }
      
      nav a {
        padding: 5px 10px;
        font-size: 0.9em;
      }
      
      section {
        padding: 15px;
      }
    }
  </style>
</head>
<body>
<div class="container">
  <h1>AI Photo Analyzer</h1>

  <nav>
    <a href="#privacy"><i class="fas fa-shield-alt"></i> Privacy Policy</a>
    <a href="#contact"><i class="fas fa-envelope"></i> Contact Us</a>
    <a href="#analyzer"><i class="fas fa-camera"></i> Photo Analyzer</a>
  </nav>

  <div id="analyzer">
    <div class="upload-container">
      <label class="upload-label" for="file-upload">
        <i class="fas fa-cloud-upload-alt"></i> Choose Photo
      </label>
      <input id="file-upload" type="file" accept="image/*" onchange="previewImage(event)">
    </div>
    
    <div class="loading" id="loading">
      <div class="spinner"></div>
      <p>Analyzing your photo...</p>
    </div>
    
    <img id="preview" src="#" alt="Image Preview">

    <button id="analyze-btn" onclick="analyzeImage()" disabled>
      <i class="fas fa-search"></i> Analyze Photo
    </button>

    <div class="result" id="result">
      <h2>Analysis Result</h2>
      <div class="result-item">
        <span><strong>Age:</strong> <span id="age"></span></span>
      </div>
      <div class="result-item">
        <span><strong>Emotion:</strong> <span id="emotion"></span></span>
      </div>
      <div class="result-item">
        <span><strong>Relationship Status:</strong> <span id="status"></span></span>
      </div>
      <div class="result-item">
        <span><strong>Mood Level:</strong> <span id="mood"></span>%</span>
        <div class="progress-container">
          <div class="progress-bar" id="mood-bar"></div>
        </div>
      </div>
      <div class="flags" id="flagContainer"></div>
    </div>
  </div>

  <section id="privacy">
    <h2><i class="fas fa-shield-alt"></i> Privacy Policy</h2>
    <p>We respect your privacy. All uploaded images are processed locally in your browser and not stored on any server. No data is collected or shared with third parties.</p>
    <p>Our AI analysis happens completely in your browser using advanced machine learning models. Your photos never leave your device.</p>
  </section>

  <section id="contact">
    <h2><i class="fas fa-envelope"></i> Contact Us</h2>
    <p>Email: <a href="mailto:ghufranworld@gmail.com" style="color:var(--accent-color);">ghufranworld@gmail.com</a></p>
    <p>For support or questions about our AI analyzer, please contact us via email.</p>
    <div class="social-links" style="margin-top: 15px;">
      <a href="#" style="color: var(--text-color); margin: 0 10px; font-size: 1.5em;"><i class="fab fa-twitter"></i></a>
      <a href="#" style="color: var(--text-color); margin: 0 10px; font-size: 1.5em;"><i class="fab fa-instagram"></i></a>
      <a href="#" style="color: var(--text-color); margin: 0 10px; font-size: 1.5em;"><i class="fab fa-github"></i></a>
    </div>
  </section>

  <footer>
    &copy; <span id="year"></span> AI Photo Analyzer | All Rights Reserved
  </footer>
</div>

<script>
// Set current year in footer
document.getElementById('year').textContent = new Date().getFullYear();

function previewImage(event) {
  const reader = new FileReader();
  const analyzeBtn = document.getElementById('analyze-btn');
  
  reader.onload = function(){
    const output = document.getElementById('preview');
    output.src = reader.result;
    output.style.display = 'block';
    document.getElementById('result').style.display = 'none';
    analyzeBtn.disabled = false;
    analyzeBtn.classList.add('pulse');
  };
  
  if(event.target.files[0]) {
    reader.readAsDataURL(event.target.files[0]);
  }
}

async function analyzeImage() {
  const preview = document.getElementById('preview');
  const analyzeBtn = document.getElementById('analyze-btn');
  const loading = document.getElementById('loading');
  
  if(!preview.src || preview.src === '#') {
    showAlert('Please upload an image first!');
    return;
  }

  // Show loading state
  analyzeBtn.disabled = true;
  loading.style.display = 'block';
  
  // Simulate AI processing delay
  await new Promise(resolve => setTimeout(resolve, 1500 + Math.random() * 2000));
  
  const result = document.getElementById('result');
  const age = Math.floor(Math.random() * (23 - 15 + 1)) + 15;
  const mood = Math.floor(Math.random() * (100 - 50 + 1)) + 50;
  
  const emotions = ['Happy', 'Neutral', 'Excited', 'Calm', 'Surprised', 'Confident'];
  const statuses = ['Single', 'In a relationship', 'Married', 'Complicated', 'Divorced'];
  
  document.getElementById('age').innerText = age;
  document.getElementById('mood').innerText = mood;
  document.getElementById('mood-bar').style.width = `${mood}%`;
  document.getElementById('emotion').innerText = emotions[Math.floor(Math.random() * emotions.length)];
  document.getElementById('status').innerText = statuses[Math.floor(Math.random() * statuses.length)];

  const countries = [
    {code: 'us', name: 'USA'},
    {code: 'gb', name: 'UK'},
    {code: 'ca', name: 'Canada'},
    {code: 'au', name: 'Australia'},
    {code: 'fr', name: 'France'},
    {code: 'de', name: 'Germany'},
    {code: 'jp', name: 'Japan'},
    {code: 'br', name: 'Brazil'}
  ];
  const randomCountry = countries[Math.floor(Math.random() * countries.length)];

  document.getElementById('flagContainer').innerHTML = `
    <div class="result-item">
      <span><strong>Likely Nationality:</strong> ${randomCountry.name}</span>
    </div>
    <img src="https://flagcdn.com/w160/${randomCountry.code}.png" 
         alt="${randomCountry.name} Flag"
         style="width: 160px; height: auto; margin-top: 10px;">
  `;

  // Hide loading and show result
  loading.style.display = 'none';
  result.style.display = 'block';
  result.scrollIntoView({ behavior: 'smooth' });
  
  // Re-enable button
  analyzeBtn.disabled = false;
}

function showAlert(message) {
  const alertDiv = document.createElement('div');
  alertDiv.style.position = 'fixed';
  alertDiv.style.top = '20px';
  alertDiv.style.left = '50%';
  alertDiv.style.transform = 'translateX(-50%)';
  alertDiv.style.backgroundColor = 'rgba(255, 0, 0, 0.8)';
  alertDiv.style.color = 'white';
  alertDiv.style.padding = '15px 25px';
  alertDiv.style.borderRadius = '5px';
  alertDiv.style.zIndex = '1000';
  alertDiv.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
  alertDiv.style.animation = 'fadeIn 0.3s';
  alertDiv.textContent = message;
  
  document.body.appendChild(alertDiv);
  
  setTimeout(() => {
    alertDiv.style.animation = 'fadeIn 0.3s reverse';
    setTimeout(() => document.body.removeChild(alertDiv), 300);
  }, 3000);
}
</script>
</body>
</html>
